  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# เซลล์ที่ 4: Plot กราฟ\\n",
    "df_plot = result['df']\\n",
    "\\n",
    "fig, axes = plt.subplots(3, 1, figsize=(14, 12))\\n",
    "\\n",
    "# กราฟที่ 1: ราคา + EWMA\\n",
    "ax1 = axes[0]\\n",
    "ax1.plot(df_plot.index, df_plot['Close'], label='Close Price', color='black', alpha=0.7)\\n",
    "ax1.plot(df_plot.index, df_plot['EWMA_fast'], label=f'EWMA Fast (span=10)', color='blue', linewidth=2)\\n",
    "ax1.plot(df_plot.index, df_plot['EWMA_slow'], label=f'EWMA Slow (span=30)', color='red', linewidth=2)\\n",
    "\\n",
    "# จุดซื้อ (Signal=1 เมื่อ position เปลี่ยน)\\n",
    "buy_signals = df_plot[(df_plot['Position'] == 1) & (df_plot['Position'].shift(1) != 1)]\\n",
    "sell_signals = df_plot[(df_plot['Position'] == -1) & (df_plot['Position'].shift(1) != -1)]\\n",
    "ax1.scatter(buy_signals.index, buy_signals['Close'], marker='^', color='green', s=100, label='Buy Signal')\\n",
    "ax1.scatter(sell_signals.index, sell_signals['Close'], marker='v', color='red', s=100, label='Sell Signal')\\n",
    "ax1.set_title('Price & EWMA Crossover Signals')\\n",
    "ax1.legend()\\n",
    "ax1.grid(True, alpha=0.3)\\n",
    "\\n",
    "# กราฟที่ 2: Equity Curve\\n",
    "ax2 = axes[1]\\n",
    "ax2.plot(df_plot.index, df_plot['Cumulative_Strategy'], label='Strategy', color='blue', linewidth=2)\\n",
    "ax2.plot(df_plot.index, df_plot['Cumulative_BuyHold'], label='Buy & Hold', color='gray', linewidth=2, linestyle='--')\\n",
    "ax2.set_title('Equity Curve')\\n",
    "ax2.legend()\\n",
    "ax2.grid(True, alpha=0.3)\\n",
    "\\n",
    "# กราฟที่ 3: Drawdown\\n",
    "ax3 = axes[2]\\n",
    "ax3.fill_between(df_plot.index, 0, df_plot['Drawdown'], color='red', alpha=0.3)\\n",
    "ax3.plot(df_plot.index, df_plot['Drawdown'], color='red', linewidth=1)\\n",
    "ax3.set_title('Drawdown')\\n",
    "ax3.set_ylabel('Drawdown %')\\n",
    "ax3.grid(True, alpha=0.3)\\n",
    "\\n",
    "plt.tight_layout()\\n",
    "plt.savefig('projects/02_ewma_crossover/ewma_result.png', dpi=100, bbox_inches='tight')\\n",
    "plt.show()"
   ]
