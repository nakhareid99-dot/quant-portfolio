# รัน Notebook (หรือทดสอบโดยตรง)
import sys
sys.path.append('/content/projects/01_monte_carlo/quant-portfolio')
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from src.data_fetcher import DataFetcher
from strategy import generate_signals, backtest

sns.set_style('darkgrid')

# ดึงข้อมูล
df = DataFetcher.get_stock_data('AAPL', start='2020-01-01')

# ทดสอบกลยุทธ์
df_strategy = generate_signals(df, fast_span=10, slow_span=30)
result = backtest(df_strategy, initial_capital=100000)

# แสดงผล
print('📊 ผลลัพธ์ Backtest EWMA Crossover')
print('=' * 40)
print(f'Total Return (Strategy):     {result["total_return"]:.2%}')
print(f'Total Return (Buy & Hold):   {result["buy_hold_return"]:.2%}')
print(f'Sharpe Ratio:                {result["sharpe_ratio"]:.2f}')
print(f'Max Drawdown:                {result["max_drawdown"]:.2%}')
print(f'Win Rate:                    {result["win_rate"]:.2%}')
print(f'Final Capital:               ${result["final_capital"]:,.2f}')
